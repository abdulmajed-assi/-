<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>البلد فود - Albald Food</title>
    <!-- استيراد خط عربي أنيق -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- مكتبة الأيقونات FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary-green: #00b074;
            --primary-orange: #ff7010;
            --bg-color: #f8f9fa;
            --text-main: #333333;
            --text-secondary: #717171;
            --border-color: #e5e5e5;
            --white: #ffffff;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
        }

        /* الهيدر العلوي */
        header {
            background-color: var(--white);
            border-bottom: 1px solid var(--border-color);
            padding: 15px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary-green);
        }

        .search-location-bar {
            display: flex;
            align-items: center;
            background: #f1f1f1;
            border-radius: 8px;
            padding: 8px 15px;
            width: 50%;
        }

        .search-location-bar input {
            border: none;
            background: transparent;
            outline: none;
            width: 100%;
            padding: 0 10px;
            font-size: 14px;
        }

        .auth-buttons button {
            padding: 8px 20px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            margin-left: 10px;
        }

        .btn-login {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-main);
        }

        .btn-register {
            background: var(--primary-green);
            border: none;
            color: var(--white);
        }

        /* الشريط الإعلاني العرضي */
        .top-banner {
            background: linear-gradient(135deg, #e53935, #b71c1c);
            color: var(--white);
            padding: 20px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 20px 5%;
            border-radius: 12px;
        }

        .container {
            display: flex;
            padding: 0 5%;
            gap: 30px;
        }

        /* الفلتر الجانبي */
        sidebar {
            width: 250px;
            background: var(--white);
            padding: 20px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            height: fit-content;
        }

        sidebar h3 {
            font-size: 16px;
            margin-bottom: 15px;
            color: var(--text-main);
        }

        .filter-group {
            margin-bottom: 20px;
        }

        .filter-group label {
            display: block;
            font-size: 14px;
            color: var(--text-secondary);
            margin-bottom: 8px;
            cursor: pointer;
        }

        /* المحتوى الرئيسي */
        main {
            flex: 1;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .section-header h2 {
            font-size: 20px;
        }

        .section-header a {
            color: var(--primary-green);
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
        }

        /* قسم المطبخ (Mutfaklar) - دوائر متجاورة */
        .mutfaklar-slider {
            display: flex;
            gap: 20px;
            overflow-x: auto;
            padding-bottom: 15px;
            margin-bottom: 30px;
            scrollbar-width: none;
        }

        .mutfaklar-slider::-webkit-scrollbar {
            display: none;
        }

        .mutfak-item {
            text-align: center;
            min-width: 90px;
            cursor: pointer;
        }

        .mutfak-item img {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--border-color);
            transition: 0.3s;
        }

        .mutfak-item img:hover {
            border-color: var(--primary-green);
        }

        .mutfak-item p {
            font-size: 13px;
            margin-top: 8px;
            font-weight: 600;
        }

        /* قسم المطاعم (Restoranlar) */
        .restoranlar-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }

        .restoran-card {
            background: var(--white);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            transition: 0.3s;
            cursor: pointer;
        }

        .restoran-card:hover {
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }

        .restoran-img-container {
            position: relative;
            height: 160px;
        }

        .restoran-img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .badge-discount {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background: #d32f2f;
            color: var(--white);
            padding: 4px 10px;
            font-size: 11px;
            border-radius: 4px;
            font-weight: 600;
        }

        .restoran-info {
            padding: 15px;
        }

        .restoran-title-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .restoran-name {
            font-weight: 700;
            font-size: 16px;
        }

        .restoran-rating {
            background: #e8f5e9;
            color: var(--primary-green);
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
        }

        .restoran-details {
            font-size: 12px;
            color: var(--text-secondary);
            display: flex;
            gap: 10px;
        }

        /* الشريط الجانبي السريع للهبوط */
        .quick-sidebar {
            position: fixed;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            gap: 10px;
            z-index: 999;
        }

        .quick-sidebar a {
            background: var(--white);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            color: var(--text-main);
            text-decoration: none;
            transition: 0.3s;
        }

        .quick-sidebar a:hover {
            background: var(--primary-green);
            color: var(--white);
        }
    </style>
</head>
<body>

    <!-- الهيدر العلوي -->
    <header>
        <div class="logo">البلد فود</div>
        <div class="search-location-bar">
            <i class="fa-solid fa-location-dot" style="color: var(--primary-orange);"></i>
            <input type="text" placeholder="حدد موقعك (المدينة / المنطقة)..." id="locationInput">
            <i class="fa-solid fa-search" style="color: var(--text-secondary);"></i>
            <input type="text" placeholder="ابحث عن مطعم، مطبخ أو وجبة..." style="border-right: 1px solid var(--border-color); margin-right: 10px;">
        </div>
        <div class="auth-buttons">
            <button class="btn-login"><i class="fa-solid fa-user"></i> تسجيل الدخول</button>
            <button class="btn-register" onclick="window.open('https://wa.me/your-number', '_blank')">حساب تاجر (واتساب)</button>
        </div>
    </header>

    <!-- الشريط الإعلاني العرضي العلوي (تحكم الأدمن) -->
    <div class="top-banner">
        <div>
