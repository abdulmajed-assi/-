<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>البلد فود - Albald Food</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary-green: #00b074;
            --primary-orange: #ff7010;
            --bg-color: #f8f9fa;
            --text-main: #333333;
            --text-secondary: #717171;
            --border-color: #e5e5e5;
            --white: #ffffff;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Cairo', sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-main); }

        header {
            background-color: var(--white); border-bottom: 1px solid var(--border-color);
            padding: 15px 5%; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 1000;
        }
        .logo { font-size: 24px; font-weight: 700; color: var(--primary-green); }
        .search-location-bar { display: flex; align-items: center; background: #f1f1f1; border-radius: 8px; padding: 8px 15px; width: 40%; }
        .search-location-bar input { border: none; background: transparent; outline: none; width: 100%; padding: 0 10px; font-size: 14px; }
        
        .auth-buttons { display: flex; gap: 10px; }
        .auth-buttons button { padding: 8px 15px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 13px; }
        .btn-login { background: transparent; border: 1px solid var(--border-color); color: var(--text-main); }
        .btn-register { background: var(--primary-green); border: none; color: var(--white); }
        .btn-admin { background: #333; border: none; color: var(--white); }

        .top-banner { background: linear-gradient(135deg, #e53935, #b71c1c); color: var(--white); padding: 20px 5%; display: flex; justify-content: space-between; align-items: center; margin: 20px 5%; border-radius: 12px; }
        .container { display: flex; padding: 0 5%; gap: 30px; }
        sidebar { width: 250px; background: var(--white); padding: 20px; border-radius: 12px; border: 1px solid var(--border-color); height: fit-content; }
        .filter-group { margin-bottom: 20px; }
        .filter-group label { display: block; font-size: 14px; color: var(--text-secondary); margin-bottom: 8px; cursor: pointer; }
        main { flex: 1; }
        .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .mutfaklar-slider { display: flex; gap: 20px; overflow-x: auto; padding-bottom: 15px; margin-bottom: 30px; scrollbar-width: none; }
        .mutfak-item { text-align: center; min-width: 90px; cursor: pointer; }
        .mutfak-item img { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 2px solid var(--border-color); }
        .mutfak-item p { font-size: 13px; margin-top: 8px; font-weight: 600; }
        .restoranlar-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
        .restoran-card { background: var(--white); border-radius: 12px; overflow: hidden; border: 1px solid var(--border-color); }
        .restoran-img-container { position: relative; height: 160px; }
        .restoran-img-container img { width: 100%; height: 100%; object-fit: cover; }
        .badge-discount { position: absolute; bottom: 10px; right: 10px; background: #d32f2f; color: var(--white); padding: 4px 10px; font-size: 11px; border-radius: 4px; }
        .restoran-info { padding: 15px; }
        .restoran-title-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
        .restoran-name { font-weight: 700; font-size: 16px; }
        .restoran-rating { background: #e8f5e9; color: var(--primary-green); padding: 3px 8px; border-radius: 6px; font-size: 12px; }

        /* نافذة منبثقة لتسجيل الدخول العادي عبر جوجل */
        #googleModal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 3000; justify-content: center; align-items: center; }
        .modal-content { background: white; padding: 30px; border-radius: 12px; width: 350px; text-align: center; }
        .btn-google { background: #4285F4; color: white; border: none; padding: 10px 20px; border-radius: 6px; width: 100%; font-weight: bold; cursor: pointer; margin-top: 15px; }
    </style>
</head>
<body>

    <header>
        <div class="logo">البلد فود</div>
        <div class="search-location-bar">
            <i class="fa-solid fa-location-dot" style="color: var(--primary-orange);"></i>
            <input type="text" placeholder="حدد موقعك تلقائياً (المدينة)...">
        </div>
        <div class="auth-buttons">
            <button class="btn-login" onclick="openGoogleModal()"><i class="fa-solid fa-user"></i> تسجيل الدخول</button>
            <button class="btn-register" onclick="location.href='merchant-login.html'"><i class="fa-solid fa-store"></i> حساب تاجر</button>
            <button class="btn-admin" onclick="location.href='admin.html'"><i class="fa-solid fa-lock"></i> لوحة الأدمن</button>
        </div>
    </header>

    <!-- نافذة تسجيل الدخول العادي (Google) -->
    <div id="googleModal">
        <div class="modal-content">
            <h3>تسجيل الدخول للحساب العادي</h3>
            <p style="font-size: 13px; color: #666; margin: 10px 0;">سجل دخولك بضغطة واحدة باستخدام حساب جوجل الخاص بك للتقييم والتصفح.</p>
            <button class="btn-google" onclick="alert('تم تسجيل الدخول بنجاح عبر حساب Google!')"><i class="fa-brands fa-google"></i> المتابعة بواسطة Google</button>
            <br><br>
            <button onclick="closeGoogleModal()" style="background: none; border: none; color: #999; cursor: pointer;">إلغاء</button>
        </div>
    </div>

    <div class="top-banner">
        <div>
            <h2>عروض وجبات اليوم الكبرى في البلد فود!</h2>
            <p>اطلب الآن واحصل على خصومات حصرية تصل إلى 50% من أفضل المطاعم.</p>
        </div>
        <i class="fa-solid fa-fire fa-3x" style="color: #ffeb3b;"></i>
    </div>

    <div class="container">
        <sidebar>
            <h3>فلتر و ترتيب</h3>
            <div class="filter-group">
                <label><input type="checkbox" checked> كل المدن</label>
                <label><input type="checkbox"> اسطنبول</label>
            </div>
            <div class="filter-group">
                <label><strong>أقسام الطعام</strong></label>
                <label><input type="checkbox"> شاورما</label>
                <label><input type="checkbox"> برجر</label>
                <label><input type="checkbox"> بروستد</label>
            </div>
        </sidebar>

        <main>
            <div class="section-header">
                <h2>وجبات الطعام (الأقسام)</h2>
            </div>
            <div class="mutfaklar-slider">
                <div class="mutfak-item"><img src="https://images.unsplash.com/photo-1529042410759-befb1204b468?w=150"><p>شاورما</p></div>
                <div class="mutfak-item"><img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=150"><p>برجر</p></div>
                <div class="mutfak-item"><img src="https://images.unsplash.com/photo-1626777552726-4a6b54c97e46?w=150"><p>بروستد</p></div>
                <div class="mutfak-item"><img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=150"><p>فلافل</p></div>
            </div>

            <div class="section-header">
                <h2>المطاعم المتاحة</h2>
            </div>
            <div class="restoranlar-grid">
                <div class="restoran-card">
                    <div class="restoran-img-container">
                        <img src="https://images.unsplash.com/photo-1550547660-d9450f859349?w=400">
                        <div class="badge-discount">خصم 20%</div>
                    </div>
                    <div class="restoran-info">
                        <div class="restoran-title-row">
                            <span class="restoran-name">مطعم الشام الأصيل</span>
                            <span class="restoran-rating">4.8 ⭐</span>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function openGoogleModal() { document.getElementById('googleModal').style.display = 'flex'; }
        function closeGoogleModal() { document.getElementById('googleModal').style.display = 'none'; }
    </script>
</body>
</html>
