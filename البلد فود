                </div>
                <div class="mutfak-item">
                    <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591?w=150" alt="بيتزا">
                    <p>بيتزا</p>
                </div>
                <div class="mutfak-item">
                    <img src="https://images.unsplash.com/photo-1626777552726-4a6b54c97e46?w=150" alt="بروستد">
                    <p>بروستد</p>
                </div>
                <div class="mutfak-item">
                    <img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=150" alt="فلافل">
                    <p>فلافل</p>
                </div>
                <div class="mutfak-item">
                    <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=150" alt="طبخ بيت">
                    <p>طبخ بيت</p>
                </div>
                <div class="mutfak-item">
                    <img src="https://images.unsplash.com/photo-1509440159596-0249088772ff?w=150" alt="معجنات">
                    <p>معجنات</p>
                </div>
                <div class="mutfak-item">
                    <img src="https://images.unsplash.com/photo-1551024709-8f23befc6f87?w=150" alt="حلويات">
                    <p>حلويات</p>
                </div>
                <div class="mutfak-item">
                    <img src="https://images.unsplash.com/photo-1633964913295-ceb43826e7c9?w=150" alt="مندي">
                    <p>مندي</p>
                </div>
                <div class="mutfak-item">
                    <img src="https://images.unsplash.com/photo-1551024709-8f23befc6f87?w=150" alt="كوكتيل">
                    <p>كوكتيل</p>
                </div>
            </div>

            <!-- قسم كل المطاعم (Restoranlar) -->
            <div class="section-header">
                <h2>المطاعم المتاحة في مدينتك</h2>
                <a href="#">عرض الكل <i class="fa-solid fa-chevron-left"></i></a>
            </div>
            <div class="restoranlar-grid" id="restaurantsContainer">
                <!-- المطاعم ستُعرض هنا تلقائياً من قاعدة بيانات Firebase -->
                <div class="restoran-card">
                    <div class="restoran-img-container">
                        <img src="https://images.unsplash.com/photo-1550547660-d9450f859349?w=400" alt="مطعم">
                        <div class="badge-discount">خصم 20% على أول طلب</div>
                    </div>
                    <div class="restoran-info">
                        <div class="restoran-title-row">
                            <span class="restoran-name">مطعم الشام الأصيل</span>
                            <span class="restoran-rating">4.8 ⭐</span>
                        </div>
                        <div class="restoran-details">
                            <span><i class="fa-solid fa-utensils"></i> شاورما ومشاوي</span>
                            <span><i class="fa-solid fa-clock"></i> 20-30 دقيقة</span>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- الشريط الجانبي السريع للهبوط -->
    <div class="quick-sidebar">
        <a href="#" title="الاعلى"><i class="fa-solid fa-arrow-up"></i></a>
        <a href="https://wa.me/" title="تواصل واتساب" target="_blank"><i class="fa-brands fa-whatsapp" style="color: #25d366;"></i></a>
