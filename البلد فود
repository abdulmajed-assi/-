            </div>
        </sidebar>

        <!-- الأقسام والمطاعم -->
        <main>
            <!-- قسم وجبات الطعام (Mutfaklar) الدائرية -->
            <div class="section-header">
                <h2>وجبات الطعام (الأقسام)</h2>
